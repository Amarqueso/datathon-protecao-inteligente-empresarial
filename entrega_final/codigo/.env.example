# Copie para .env (opcional: só o assistente com LLM usa)
# Gemini (gratuito, chave em aistudio.google.com/apikey) pela API compatível com a OpenAI:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash
# Para usar a própria OpenAI: apague OPENAI_BASE_URL e use OPENAI_MODEL=gpt-5.4-mini
